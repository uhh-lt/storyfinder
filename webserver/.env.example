# Environment configuration for StoryFinder webserver

# --- Runtime ---
# NODE_ENV influences default log level (debug in dev, info in prod)
NODE_ENV=development

# --- Logging ---
# error|warn|info|debug
LOG_LEVEL=debug
# 'true' to also print to console
LOG_ENABLE_CONSOLE=true
# Daily rotation to storyfinder-YYYY-MM-DD.log in LOG_DIR
LOG_ROTATE_DAILY=true
# Directory where logs are written
LOG_DIR=./webserver/logs
# Optional: write to a single file (only used if LOG_ROTATE_DAILY=false)
# LOG_FILE=./webserver/logs/storyfinder.log
# Only report slow requests (ms) at info; 4xx/5xx always logged
LOG_HTTP_SLOW_MS=400

# --- Database (MySQL) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=storyfinder
MYSQL_PASSWORD=storyfinder
MYSQL_DATABASE=storyfinder

# --- Cookies / sessions ---
# Random string; change in production
COOKIE_SECRET=change-me
# true when behind HTTPS / reverse proxy
COOKIE_SECURE=false

# --- Browser plugin integration ---
# Set to your Chrome extension id to patch into public/js/storyfinder.js
CHROME_ID=

# --- NLP backend ---
# Base URL for NLP service used by chat endpoints
NLP_BASE_URL=http://host.docker.internal:9000

# --- Chat and context limits ---
MAX_CHAT_HISTORY=20
CTX_MAX_ARTICLES=7
CTX_PER_ARTICLE_CHARS=33000
CTX_TOTAL_MAX_CHARS=100000

# Add any private API keys below (do not commit .env)
# EXAMPLE_API_KEY=
